{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer" },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":                           { "type": "boolean" },
        "minReplicas":                       { "type": "integer" },
        "maxReplicas":                       { "type": "integer" },
        "targetCPUUtilizationPercentage":    { "type": "integer" },
        "targetMemoryUtilizationPercentage": { "type": "integer" },
        "customMetric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":             { "type": "boolean" },
            "name":                { "type": "string" },
            "targetAverageValue":  { "type": "string" }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":   { "type": "boolean" },
        "namespace": { "type": "string" }
      }
    },
    "version": { "type": "string" },
    "canary": {
      "type": "object",
      "properties": {
        "version":      { "type": "string" },
        "replicaCount": { "type": "integer" }
      }
    },
    "istio": {
      "type": "object",
      "properties": {
        "peerAuthentication": {
          "type": "object",
          "properties": {
            "mode":    { "type": "string", "enum": ["STRICT", "PERMISSIVE", "DISABLE"] }
          }
        },
        "destinationRule": {
          "type": "object",
          "properties": {
            "outlierDetection": {
              "type": "object",
              "properties": {
                "consecutive5xxErrors": { "type": "integer" },
                "maxEjectionPercent":  { "type": "integer" }
              }
            }
          }
        },
        "virtualService": {
          "type": "object",
          "properties": {
            "stableWeight":  { "type": "integer" },
            "canaryWeight":  { "type": "integer" },
            "timeout":       { "type": "string" },
            "retries": {
              "type": "object",
              "properties": {
                "attempts": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
