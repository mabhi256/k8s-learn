{
    "name": "users-api",
    "version": "1.0.0",
    "main": "dist/src/index.js",
    "scripts": {
        "generate:proto": "mkdir -p ./generated && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --proto_path=./src --ts_proto_out=./generated --ts_proto_opt=outputServices=grpc-js,env=node,esModuleInterop=true ./src/notify.proto",
        "build": "tsc",
        "dev": "tsx src/index.ts",
        "start": "node dist/src/index.js"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.12.0",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "express": "^5.2.1",
        "pg": "^8.20.0",
        "pino": "^9.7.0",
        "pino-http": "^10.5.0",
        "prom-client": "^15.1.3",
        "@opentelemetry/api":"^1.9.1",
        "@opentelemetry/sdk-node":"^0.218.0",
        "@opentelemetry/auto-instrumentations-node": "^0.76.0",
        "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.19.19",
        "@types/pg": "^8.20.0",
        "grpc-tools": "^1.13.1",
        "ts-proto": "^2.11.8",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3"
    }
}
